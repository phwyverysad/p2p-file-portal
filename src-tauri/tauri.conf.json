{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "P2P File Portal",
  "version": "1.0.1",
  "identifier": "com.phwyverysad.p2pfileportal",
  "build": {
    "beforeDevCommand": "node build.js",
    "beforeBuildCommand": "node build.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "P2P File Portal",
        "width": 880,
        "height": 780,
        "minWidth": 620,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
